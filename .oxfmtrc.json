{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "arrowParens": "always",
  "ignorePatterns": ["dist/**", "demo/**", "tests/assets/**", "src/uniwheel.js", "*.html", "*.md", "*.yml", "*.yaml", "*.json"]
}
